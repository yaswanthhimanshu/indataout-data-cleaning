# .env.example - Template for users
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=indataout_user
DB_PASSWORD=your-password-here
DB_NAME=indataout

# Application Configuration
HOST=127.0.0.1
PORT=5000

# Security
# Set to 1 for local desktop use, 0 for network deployment
INDATAOUT_TRUSTED_LOCAL=1

# Storage (optional)
# UPLOAD_FOLDER=uploads